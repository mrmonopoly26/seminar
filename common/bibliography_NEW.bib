	keywords = {GPU-computing, Machine Laerning, Python (programming language), PyTorch, reinforcement learning (RL)., Spiking Network},
	file = {Full Text PDF:/Users/tobiasderks/Zotero/storage/X6XVV79U/Hazan et al. - 2018 - BindsNET A Machine Learning-Oriented Spiking Neural Networks Library in Python.pdf:application/pdf},
