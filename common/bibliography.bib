	url = {https://ccneuro.org/2019/Papers/ViewPapers.asp?PaperNum=1109},
	doi = {10.32470/CCN.2019.1109-0},
	abstract = {The size and complexity of the neural networks investigated in computational neuroscience are increasing, leading to a need for efﬁcient neural simulation tools to support their development. Several neuro-simulators have been developed over the years by the community, all with different scopes (rate-coded, spiking, mean-ﬁeld), target platforms ({CPU}, {GPU}, clusters) or modeling principles (ﬁxed model library, code generation). We compare here the current version of the neuro-simulator {ANNarchy} against other state-of-the-art simulators on ratecoded and spiking benchmarks with a focus on their parallel performance.},
